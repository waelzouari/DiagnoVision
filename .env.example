# Runtime
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Authentication (replace every value outside local demo use)
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_MINUTES=15
REFRESH_DAYS=7
SECURE_COOKIES=false
CSRF_COOKIE_NAME=diagnovision_csrf

# PostgreSQL / pgvector
POSTGRES_DB=diagnovision
POSTGRES_USER=diagnovision
POSTGRES_PASSWORD=diagnovision-local-only
DATABASE_URL=postgresql+psycopg://diagnovision:diagnovision-local-only@postgres:5432/diagnovision

# Redis / task processing
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ANALYSIS_INTERVAL_SECONDS=86400
DEMO_ANALYSIS_INTERVAL_SECONDS=60

# Private object storage
MINIO_ROOT_USER=diagnovision
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=diagnovision-private
MINIO_ACCESS_KEY=diagnovision
MINIO_SECRET_KEY=change-me-minio-local-only
MINIO_SECURE=false

# AI providers. mock is deterministic and is the only safe demo default.
AI_PROVIDER=mock
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
WHISPER_PROVIDER=mock
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_VAD=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OCR_PROVIDER=mock

# Upload and privacy limits
MAX_UPLOAD_BYTES=104857600
MAX_AUDIO_UPLOAD_MB=100
MAX_DOCUMENT_UPLOAD_MB=25
DATA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Public build-time variables only; never place secrets in VITE_* values.
VITE_APP_NAME=DiagnoVision
VITE_DEMO_MODE=true
